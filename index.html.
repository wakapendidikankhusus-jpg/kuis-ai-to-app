function bank(s){return s==='pre'?PRE:QS}
function ea(t){return esc(String(t)).replace(/"/g,'&quot;')}
function drawQR(el){try{new QRCode(el,{text:S.link||selfURL()||LINK,width:220,height:220,colorDark:'#0E3B43',colorLight:'#ffffff'})}catch(e){el.textContent=LINK}}
function showQR(){var c=$('#qrc');if(c.innerHTML){c.innerHTML='';return}c.innerHTML='<div class="card pop" style="text-align:center;margin-top:14px"><div id="qrx" style="display:inline-block;padding:10px;background:#fff;border-radius:12px"></div><p>Pindai untuk membuka kuis</p></div>';drawQR($('#qrx'))}
function refreshHome(){if($('.hero')){S.name=$('#nm').value;home()}}
function init(){
 if(!(window.claude&&claude.use))return;
 claude.use('user').then(function(u){return u?u.canEdit():false}).then(function(ok){if(ok){S.admin=1;refreshHome()}}).catch(function(){});
 claude.use('db').then(function(db){if(!db)return;S.db=db;db.doc('bank/link').get().then(function(sn){var d=sn.data();if(d&&d.url)S.link=d.url}).catch(function(){});['kuis','pre'].forEach(function(k){db.doc('bank/'+k).get().then(function(sn){var d=sn.data();if(d&&d.json){var a=JSON.parse(d.json),t=bank(k);t.length=0;a.forEach(function(x){t.push(x)})}}).catch(function(){})})}).catch(function(){});
}
function collect(){var cs=document.querySelectorAll('.qc');if(!cs.length)return;S.items=[].map.call(cs,function(c){return{q:c.querySelector('.eq').value,o:[].map.call(c.querySelectorAll('.eo'),function(i){return i.value}),a:+c.querySelector('.ea').value,e:c.querySelector('.ee').value}})}
function admin(tab){
 stop();if(S.unsub){S.unsub();S.unsub=null}
 tab=tab||'soal';var set=S.aset||'kuis';
 function tb(t,l){return'<button class="btn'+(tab===t?'':' ghost')+'" data-t="'+t+'">'+l+'</button>'}
 app.innerHTML='<div class="top"><button class="btn ghost" id="hm" style="padding:6px 12px">← Menu</button><span class="pill">Panel Admin</span></div><div class="row">'+tb('soal','Soal')+tb('hasil','Hasil')+tb('qr','Bagikan')+'</div>'+
 '<select id="st" aria-label="Set soal" style="margin-top:12px"><option value="kuis">Kuis Kilat (dari materi PDF)</option><option value="pre">Tes Awal Bapak/Ibu (20 soal)</option></select><div id="ad" style="margin-top:12px"></div>';
 $('#st').value=set;$('#st').onchange=function(){S.aset=this.value;S.items=null;admin(tab)};
 $('#hm').onclick=home;
 document.querySelectorAll('[data-t]').forEach(function(b){b.onclick=function(){collect();admin(b.dataset.t)}});
 ({soal:aSoal,hasil:aHasil,qr:aQR})[tab](set);
}
function parseFile(t,n){
 t=t.replace(/^\uFEFF/,'');
 if(/\.json$/i.test(n))return JSON.parse(t).map(function(x){return{q:String(x.q),o:x.o.map(String).slice(0,4),a:+x.a||0,e:String(x.e||'')}});
 var ls=t.split(/\r?\n/).filter(function(l){return l.trim()}),d=ls[0].indexOf(';')>-1?';':',';
 var rows=ls.map(function(l){return l.split(d)});
 if('ABCD'.indexOf((rows[0][5]||'').trim().toUpperCase())<0||!(rows[0][5]||'').trim())rows.shift();
 return rows.map(function(r){return{q:r[0].trim(),o:r.slice(1,5).map(function(x){return(x||'').trim()}),a:Math.max(0,'ABCD'.indexOf((r[5]||'A').trim().toUpperCase())),e:(r[6]||'').trim()}});
}
function aSoal(set){
 if(!S.items)S.items=JSON.parse(JSON.stringify(bank(set)));
 var h='<p style="color:var(--muted)">Ubah soal, pilih kunci jawaban, lalu tekan Simpan. Perubahan langsung dipakai peserta. File CSV: kolom pertanyaan, A, B, C, D, kunci (A-D), penjelasan; atau file JSON.</p><div class="row"><button class="btn" id="ad1">+ Soal</button><button class="btn" id="sv" style="background:var(--c)">Simpan</button><label class="btn ghost" style="text-align:center">Unggah file<input type="file" id="fu" accept=".json,.csv,.txt" hidden></label></div><p id="msg" role="status" style="font-weight:800"></p>';
 S.items.forEach(function(it,i){h+='<div class="card qc" style="margin-top:12px"><b>Soal '+(i+1)+'</b><textarea class="eq" rows="2" style="margin:6px 0">'+esc(it.q)+'</textarea>'+[0,1,2,3].map(function(k){return'<input class="eo" aria-label="Pilihan '+'ABCD'[k]+'" style="margin-bottom:6px" value="'+ea(it.o[k]||'')+'">'}).join('')+'<select class="ea" aria-label="Kunci jawaban">'+[0,1,2,3].map(function(k){return'<option value="'+k+'"'+(it.a===k?' selected':'')+'>Kunci: '+'ABCD'[k]+'</option>'}).join('')+'</select><input class="ee" style="margin-top:6px" aria-label="Penjelasan" placeholder="Penjelasan" value="'+ea(it.e||'')+'"><button class="btn ghost del" data-i="'+i+'" style="margin-top:8px">Hapus soal</button></div>'});
 $('#ad').innerHTML=h;
 $('#ad1').onclick=function(){collect();S.items.push({q:'',o:['','','',''],a:0,e:''});aSoal(set)};
 document.querySelectorAll('.del').forEach(function(b){b.onclick=function(){collect();S.items.splice(+b.dataset.i,1);aSoal(set)}});
 $('#sv').onclick=function(){collect();var m=$('#msg');
  if(S.items.some(function(x){return!x.q.trim()||x.o.some(function(o){return!o.trim()})})){m.textContent='Lengkapi teks soal dan keempat pilihan.';return}
  if(!S.db){m.textContent='Database belum terhubung. Buka ulang halaman.';return}
  S.db.doc('bank/'+set).set({json:JSON.stringify(S.items)}).then(function(){var t=bank(set);t.length=0;S.items.forEach(function(x){t.push(JSON.parse(JSON.stringify(x)))});m.textContent='Tersimpan ✅ ('+S.items.length+' soal)'}).catch(function(){m.textContent='Gagal menyimpan. Pastikan kamu masuk sebagai pemilik.'})};
 $('#fu').onchange=function(){var f=this.files[0];if(!f)return;var r=new FileReader();r.onload=function(){try{S.items=parseFile(r.result,f.name);aSoal(set);$('#msg').textContent=S.items.length+' soal dimuat. Tekan Simpan untuk menerapkan.'}catch(e){$('#msg').textContent='Format file tidak dikenali.'}};r.readAsText(f)};
}
function aHasil(set){
 var el=$('#ad');el.innerHTML='<p id="cnt" style="font-weight:800">Memuat…</p><div style="overflow-x:auto"><table id="tbl" style="width:100%;border-collapse:collapse"></table></div><button class="btn" id="dl" style="margin-top:12px">Unduh CSV</button>';
 if(!S.db){$('#cnt').textContent='Database belum terhubung.';return}
 var rows=[];
 S.unsub=S.db.collection('scores_'+set).orderBy('score','desc').limit(500).onSnapshot(function(sn){rows=sn.docs.map(function(d){return d.data()});$('#cnt').textContent=rows.length+' hasil';
  $('#tbl').innerHTML='<tr><th align="left">#</th><th align="left">Nama</th><th>Skor</th><th>Benar</th><th>Waktu</th></tr>'+rows.map(function(x,i){return'<tr><td>'+(i+1)+'</td><td>'+esc(String(x.name))+'</td><td align="center">'+Number(x.score)+'</td><td align="center">'+Number(x.ok)+'</td><td align="center">'+new Date(x.ts).toLocaleString('id-ID')+'</td></tr>'}).join('')},function(){$('#cnt').textContent='Gagal memuat hasil.'});
 $('#dl').onclick=function(){claude.use('downloads').then(function(d){if(!d)return;var c='Nama,Skor,Benar,Waktu\n'+rows.map(function(x){return['"'+String(x.name).replace(/"/g,'""')+'"',x.score,x.ok,'"'+new Date(x.ts).toLocaleString('id-ID')+'"'].join(',')}).join('\n');d.save({filename:'hasil-'+set+'.csv',data:c})}).catch(function(){})};
}
function aQR(){$('#ad').innerHTML='<div class="card" style="text-align:center"><div id="qrx" style="display:inline-block;padding:10px;background:#fff;border-radius:12px"></div><p style="word-break:break-all">'+(S.link||selfURL()||LINK)+'</p><p style="color:var(--muted)">Tampilkan di layar proyektor agar peserta memindai dengan kamera HP.</p></div><div class="card" style="margin-top:12px"><label for="lk" class="disp">Tempel tautan publik kuis</label><input id="lk" placeholder="https://..." style="margin:8px 0"><button class="btn" id="mk">Buat QR dari tautan ini</button><p id="lm" role="status"></p></div>';drawQR($('#qrx'));$('#lk').value=S.link||'';$('#mk').onclick=function(){var u=$('#lk').value.trim();if(!/^https:\/\//.test(u)){$('#lm').textContent='Tautan harus diawali https://';return}S.link=u;if(S.db)S.db.doc('bank/link').set({url:u}).catch(function(){});aQR()}}
function selfURL(){try{if(/^https?:$/.test(location.protocol)&&!/claude|anthropic/.test(location.hostname))return location.href.split('#')[0]}catch(e){}return null}
function login(){
 stop();
 app.innerHTML='<div class="top"><button class="btn ghost" id="hm" style="padding:6px 12px">← Menu</button><span class="pill">Login Admin</span></div><div class="card"><label for="lu" class="disp">Username</label><input id="lu" autocomplete="username" style="margin:6px 0 12px"><label for="lp" class="disp">Password</label><input id="lp" type="password" autocomplete="current-password" style="margin:6px 0 12px"><button class="btn" id="lg" style="width:100%">Masuk</button><p id="le" role="alert" style="font-weight:800"></p></div>';
 $('#hm').onclick=home;
 function go(){var m=$('#le');if(!(window.crypto&&crypto.subtle)){m.textContent='Browser tidak mendukung login ini.';return}
  crypto.subtle.digest('SHA-256',new TextEncoder().encode('kuis:'+$('#lu').value.trim().toLowerCase()+':'+$('#lp').value)).then(function(b){var h=[].map.call(new Uint8Array(b),function(x){return('0'+x.toString(16)).slice(-2)}).join('');if(h==='c209f41af489f23a6acc1aa6ac21d18060e5504d0407b865114842f062683247'){S.auth=1;admin()}else m.textContent='Username atau password salah.'})}
 $('#lg').onclick=go;$('#lp').onkeydown=function(e){if(e.key==='Enter')go()};
}
home();init();
</script>
